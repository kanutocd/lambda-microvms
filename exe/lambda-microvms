#!/usr/bin/env ruby
# frozen_string_literal: true

require 'lambda/microvms'

module Lambda
  module MicroVMs
    # Minimal CLI for the Ruby Lambda MicroVM development kit.
    class CLI
      COMMANDS = {
        'version' => :version,
        '--version' => :version,
        '-v' => :version,
        'new' => :new_project,
        'package' => :package,
        'deploy' => :deploy,
        'run' => :run_microvm,
        'doctor' => :doctor,
        'sdk-contract' => :sdk_contract,
        'function-invoke' => :function_invoke,
        'help' => :help
      }.freeze

      def initialize(argv, out: $stdout, err: $stderr)
        @argv = argv
        @out = out
        @err = err
      end

      def run
        command = @argv.shift
        action = COMMANDS[command]
        if action
          send(action)
        elsif command.nil?
          help
        else
          @err.puts "unknown command: #{command}"
          help
          1
        end
      rescue Error, ArgumentError, LoadError => e
        @err.puts "error: #{e.message}"
        1
      end

      private

      def version
        @out.puts VERSION
        0
      end

      def new_project
        name = @argv.shift || raise(ArgumentError, 'usage: lambda-microvms new NAME')
        force = @argv.include?('--force')
        Scaffold.new(name, force: force).create
        @out.puts "created #{name}"
        0
      end

      def project
        @project ||= Project.load
      end

      def package
        path = Packager.new(project).package
        @out.puts path
        0
      end

      def deploy
        image = Deployer.new(project: project).deploy
        @out.puts image.arn || image.data.inspect
        0
      end

      def run_microvm
        vm = Deployer.new(project: project).run
        @out.puts vm.id || vm.data.inspect
        0
      end

      def doctor
        checks = Doctor.new(project: project).checks
        checks.each do |check|
          marker = check.ok ? 'PASS' : 'FAIL'
          @out.puts "#{marker} #{check.name}: #{check.detail}"
        end
        checks.all?(&:ok) ? 0 : 1
      end

      def sdk_contract
        unsupported = Client.unsupported_operations
        if unsupported.empty?
          @out.puts 'Aws::Lambda::Client exposes all Lambda MicroVM operations'
          0
        else
          @err.puts "missing Aws::Lambda::Client operations: #{unsupported.join(', ')}"
          1
        end
      end

      def function_invoke
        function_name = @argv.shift || raise(ArgumentError, 'usage: lambda-microvms function-invoke NAME [JSON]')
        payload = @argv.empty? ? nil : JSON.parse(@argv.join(' '))
        result = FunctionClient.new.invoke(function_name:, payload:)
        @out.puts(result.is_a?(String) ? result : JSON.generate(result))
        0
      end

      def help
        @out.puts <<~HELP
          lambda-microvms #{VERSION}

          Commands:
            new NAME      Generate a Ruby Lambda MicroVM project using aws_lambda_ric
            doctor        Check local project readiness
            package       Create deployable source artifact
            deploy        Package, upload to S3, and create a MicroVM image
            run           Run the configured MicroVM image
            sdk-contract  Check whether aws-sdk-lambda exposes MicroVM operations
            function-invoke NAME [JSON]
                          Invoke a standard Lambda function with supported AWS APIs
            version       Print version
        HELP
        0
      end
    end
  end
end

exit Lambda::MicroVMs::CLI.new(ARGV).run
